# Copy to /etc/nx-api.env (root:nx-api, 0600) and fill in the SMTP block.
# remote-install.sh installs this file only when it is missing, so editing the
# deployed copy survives redeploys.
#
# Without SMTP_HOST the service still stores every request and only skips
# email (notification_state = not_configured).

# --- Google Workspace: SMTP relay, IP allowlist, no password (preferred) -----
# Requires one entry in the Google Admin Console allowing this host's IP:
#   Apps > Google Workspace > Gmail > Routing > SMTP relay service
#   Allowed senders: Only addresses in my domains
# The IP must be stable: use an AWS Elastic IP, otherwise a stop/start of the
# instance changes it and the relay silently starts rejecting mail.
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Optional EHLO name override (default is the OS hostname, which Google can
# reject when it is an EC2 internal name).
SMTP_HELO_NAME=

# --- Google Workspace: app password instead of relay (alternative) ----------
# Use this only if the admin console is unavailable or the IP is not stable.
# Requires 2-Step Verification on the account plus app passwords enabled by
# the organisation (Google is phasing them out, so relay is preferred).
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=hello@nx-growth.com
#   SMTP_PASSWORD=<16-char app password, no spaces>

# Inbox that receives the notification, and the From header used to send it.
# From must belong to a domain in the Google Workspace account: nx-growth.com
# is one, while nxgrowth.ai has no mail records and the relay would refuse it.
NOTIFY_TO=hello@nx-growth.com
NOTIFY_FROM=NX website <no-reply@nx-growth.com>

# Privacy policy version recorded alongside each request.
POLICY_VERSION=2026-10-05
