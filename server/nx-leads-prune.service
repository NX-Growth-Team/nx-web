[Unit]
Description=Delete Nx demo requests older than the 24 month retention window
ConditionPathExists=/var/lib/nx-api/leads.db

[Service]
Type=oneshot
User=nx-api
Group=nx-api
WorkingDirectory=/srv/nx-api
Environment=DB_PATH=/var/lib/nx-api/leads.db
EnvironmentFile=-/etc/nx-api.env
ExecStart=/usr/bin/node --experimental-sqlite --no-warnings /srv/nx-api/index.mjs --prune
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nx-api
